# ── מדידה וקידום ממומן ─────────────────────────────────────────────────
# מוגדרים ב-Vercel: Project → Settings → Environment Variables (Production).
# מה שלא מוגדר — פשוט לא נטען, והאתר עובד כרגיל.

# Google Tag Manager container. פורמט: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook) Pixel ID — מספר בן ~15 ספרות.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Backend של הטופס (כבר מוגדר ב-Vercel) ─────────────────────────────
# Google Sheet בדרייב + מייל על כל ליד (קוד הסקריפט: google-apps-script/Code.gs)
# כתובת ה-/exec של פריסת ה-Web App (הרשאה: Anyone)
SHEETS_WEBAPP_URL=
# מפתח סודי — חייב להיות זהה ל-LEAD_SECRET ב-Script Properties של הסקריפט
SHEETS_SECRET=
